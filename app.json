{
  "expo": {
    "name": "SmahiApp",
    "slug": "Natively",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/smahi.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/smahi.png",
      "resizeMode": "contain",
      "backgroundColor": "#007BFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smahi.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBypBFMwHGnv-gGDXL3VlG-IMUkU3sOT6E"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/smahi.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.smahi.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBypBFMwHGnv-gGDXL3VlG-IMUkU3sOT6E"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/smahi.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-localization",
      "expo-speech-recognition",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow S-MAHII to use your location to find nearby artisans."
        }
      ],
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/smahi.png",
          "color": "#007BFF"
        }
      ]
    ],
    "scheme": "natively",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c2c6bdb4-a08a-4618-8941-2be3172cd94f"
      }
    },
    "owner": "babagana1"
  }
}
